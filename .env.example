# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# --- LLM used for DISCOVERY only (replay never calls a model) ---
# Pick one provider: anthropic | openai | groq. If LLM_PROVIDER is empty,
# whichever key is set is used (Anthropic, then OpenAI, then Groq).
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Credentials for the LOCAL mock bank app (fake, demo-only) ---
# The model never sees these values; it only refers to {{secrets.username}}.
BANK_USERNAME=teller01
BANK_PASSWORD=demo-pass-123
